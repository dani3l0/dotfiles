[Unit]
Description=Sample sandboxed app

[Service]
WorkingDirectory=	%h/App/bin
ExecStart=		%h/App/bin/app
Restart=always
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60
TimeoutStopSec=15

# Security
BindReadOnlyPaths=	%h/App
BindPaths=		%h/App/data
ExecPaths=		%h/App/bin
ReadOnlyPaths=/
NoExecPaths=/srv
InaccessiblePaths=/boot /etc /var /run /mnt
TemporaryFileSystem=/srv:ro
ProtectHome=tmpfs
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true

[Install]
WantedBy=default.target
